# Strava integration — copy to `.env` and fill in from your Strava API application
# Create one at https://www.strava.com/settings/api (Authorization Callback Domain: localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Defaults are fine for local Docker; change only if you alter ports.
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
APP_FRONTEND_URL=http://localhost:3000
